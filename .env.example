# Copiez ce fichier en .env.local pour modifier ces valeurs (facultatif).

# Dossier où sont stockés config.json et le fichier pid du serveur.
# Par défaut : %APPDATA%\LocalGemmaAI (Windows) ou ~/.localgemma-ai
# LOCALGEMMA_DATA_DIR=

# Mode avancé / développement hors Windows : autorise l'envoi direct d'un chemin
# (sans passer par le sélecteur Windows). NE PAS activer en usage normal.
# LOCALGEMMA_ALLOW_PATH_INPUT=0
